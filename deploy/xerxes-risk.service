[Unit]
Description=Xerxes LinuxONE Risk Service
After=network.target

[Service]
Type=simple
User=linux1
Group=linux1
WorkingDirectory=/home/linux1/xerxes-risk-service
EnvironmentFile=/home/linux1/xerxes-risk-service/runtime.env
ExecStart=/home/linux1/xerxes-risk-service/.venv/bin/gunicorn --workers 2 --bind 127.0.0.1:5001 --access-logfile - --error-logfile - app:app
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
UMask=0077

[Install]
WantedBy=multi-user.target
